{
  "name": "parfuml",
  "version": "0.6.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "next build",
    "start": "next start",
    "test": "npm run lint && npm run typecheck && npm run test:public",
    "test:public": "node --test tests/public-release.test.mjs",
    "test:pages": "node --test tests/pages-export.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern node_modules",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "typescript": "7.0.2"
  },
  "type": "module",
  "displayName": "Recomendador de Perfumes do Brasil"
}
